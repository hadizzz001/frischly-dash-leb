# ========================================
# FRISCHLY SERVER - ENVIRONMENT VARIABLES
# ========================================
# SECURITY WARNING: Never commit the actual .env file to version control!
# This is a template file. Copy it to .env and fill in your actual values.

# Environment
NODE_ENV=development

# Server
PORT=3001

# Database
# Replace with your actual MongoDB connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# JWT Configuration
# Generate strong secrets using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRE=30d
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars
JWT_REFRESH_EXPIRE=7d

# CORS Configuration (IMPORTANT for Security)
# Comma-separated list of allowed origins - be specific!
# Development example:
# CLIENT_URL=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
# Production example:
# CLIENT_URL=https://yourdomain.com,https://www.yourdomain.com,https://app.yourdomain.com
# 
# SECURITY WARNING: Never use "*" (wildcard) in production!
# This would allow ANY website to make requests to your API.
CLIENT_URL=http://localhost:3001,http://localhost:3000
# Alternative: You can also use ALLOWED_ORIGINS instead of CLIENT_URL
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ImageKit (if using)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

# Cloudinary Configuration
# Get these from https://cloudinary.com/console
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL (for email links and redirects)
FRONTEND_URL=http://localhost:3000

# Backend URL (for PAYONE notifications)
BACKEND_URL=http://localhost:3001

# Email Configuration
# For Gmail: Enable 2FA and create an App Password
# Email service (optional, defaults to Gmail)
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_app_specific_password
EMAIL_FROM=Your App Name <your_email@example.com>

# Email Confirmation Settings
EMAIL_CONFIRM_REDIRECT_SUCCESS=http://localhost:3000/confirmation-success

# PAYONE Payment Gateway Configuration
# Get these from your PAYONE merchant account
MERCHANT_ID=your_merchant_id
PORTAL_ID=your_portal_id
PORTAL_KEY=your_portal_key_uuid
ACCOUNT_ID=your_account_id
PAYONE_API_BASE_URL=https://onelink.pay1.de/api

# Server Public URL (for payment confirmations)
SERVER_PUBLIC_URL=http://localhost:3001
